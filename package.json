{
  "name": "insighter",
  "version": "1.0.0",
  "description": "Explore and visualize every device sensor and hardware-facing Web API your browser exposes.",
  "private": true,
  "type": "module",
  "homepage": "https://fingerskier.github.io/insighter",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-generic-sensor": "^1.0.11",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-nfc": "^1.0.4",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
